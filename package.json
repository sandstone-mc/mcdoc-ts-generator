{
  "name": "@sandstone-mc/mcdoc-ts-generator",
  "version": "0.3.20",
  "description": "Generate TypeScript types from Minecraft mcdoc definitions",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcdoc-ts-generator": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "patches"
  ],
  "scripts": {
    "compile": "rm -rf types/ && bun run ./src/cli.ts",
    "typecheck": "bun tsc --emitDeclarationOnly false --noEmit",
    "dev:build": "bun run build:bundle && bun run build:types",
    "build:bundle": "bun build ./src/cli.ts --outfile ./dist/cli.js --target node --format esm --packages external && bun build ./src/index.ts --outfile ./dist/index.js --target node --format esm --packages external",
    "build:types": "bun tsc --emitDeclarationOnly --declaration --outDir ./dist",
    "prepublishOnly": "bun run dev:build",
    "format": "bun oxlint src --fix",
    "lint": "bun oxlint src"
  },
  "keywords": [
    "minecraft",
    "mcdoc",
    "typescript",
    "types",
    "generator",
    "datapack",
    "resourcepack"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandstone-mc/mcdoc-ts-generator.git"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxlint": "^1.79.0"
  },
  "dependencies": {
    "@seahax/eslint-plugin-wrap": "^0.6.11",
    "@spyglassmc/core": "^0.4.53",
    "@spyglassmc/java-edition": "^0.3.66",
    "@spyglassmc/mcdoc": "^0.3.57",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@typescript-eslint/type-utils": "8.67.0",
    "@typescript-eslint/typescript-estree": "8.67.0",
    "@typescript-eslint/utils": "8.67.0",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^10.8.1",
    "ts-api-utils": "2.5.0",
    "ts-pattern": "^5.9.0",
    "typescript-eslint": "8.67.0"
  },
  "patchedDependencies": {
    "@typescript-eslint/typescript-estree@8.67.0": "patches/@typescript-eslint%2Ftypescript-estree@8.67.0.patch",
    "@typescript-eslint/parser@8.67.0": "patches/@typescript-eslint%2Fparser@8.67.0.patch",
    "ts-api-utils@2.5.0": "patches/ts-api-utils@2.5.0.patch",
    "@typescript-eslint/eslint-plugin@8.67.0": "patches/@typescript-eslint%2Feslint-plugin@8.67.0.patch",
    "@typescript-eslint/type-utils@8.67.0": "patches/@typescript-eslint%2Ftype-utils@8.67.0.patch"
  }
}
